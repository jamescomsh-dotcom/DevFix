# Application database. Copy this file to .env yourself and replace every placeholder.
# URL-encode special characters in the password before placing it in the URL.
DATABASE_URL=mysql+asyncmy://devfix:change-me@127.0.0.1:3306/devfix?charset=utf8mb4

# Opt-in integration tests read this process environment variable, not .env:
# DEVFIX_TEST_DATABASE_URL=mysql+asyncmy://devfix_test:change-me@127.0.0.1:3306/devfix_test?charset=utf8mb4
